# Copy this file to .env.local and fill in your Supabase project values.
# NEVER commit .env.local or real credentials.
#
# Only the public URL and anon key belong here. Service-role keys, AI
# provider keys, and payment secrets must never be placed in frontend
# environment variables — they belong only in Supabase Edge Functions.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
